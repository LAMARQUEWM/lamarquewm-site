{
  "name": "lamarquewm-site",
  "compatibility_date": "2026-08-09",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lamarquewm-db",
      "database_id": "7357675f-c523-4bfd-8a57-0925f530dc38"
    }
  ]
}
